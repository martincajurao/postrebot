PORT=3000
JWT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=adm1
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=postre_verify
DATABASE_FILE=./data/postre.db

BASE_URL=
UPLOAD_DIR=./data/uploads

# Supabase Storage (images CRUD)
SUPABASE_URL=
SUPABASE_BUCKET=postre
# Use the service_role key on the server (bypasses RLS for storage ops).
SUPABASE_SERVICE_KEY=

# Supabase Postgres (primary database)
# Get from Supabase Dashboard > Settings > Database > Connection pooling
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Messenger-facing details shown to customers (override the placeholders).
PAYMENT_GCASH=09753122085 (M*rt*n N*ko C.)
PAYMENT_BANK=BDO: 0000-0000-0000 (Not Available)
CONTACT_PHONE=0917-000-0000
CONTACT_EMAIL=hello@postre.example
CONTACT_ADDRESS=123 Sample St.
CONTACT_HOURS=Mon-Sat, 10AM-7PM

# (Optional) Owner's Messenger PSID — sends a message on every new order.
ADMIN_PSID=

# Web Push Notifications (admin browser alerts for new orders)
# Generate with: npm run gen:vapid
VAPID_SUBJECT=mailto:admin@postre.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
