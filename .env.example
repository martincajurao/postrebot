# Supabase Postgres (primary database)
# Get from Supabase Dashboard > Settings > Database > Connection pooling
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
