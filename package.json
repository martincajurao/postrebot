{
  "name": "postre-ordering-system",
  "version": "1.0.0",
  "description": "Postre Food Products - Messenger Ordering & Reservation System",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\" && node dist/server.js",
    "postinstall": "npm run build",
    "test": "tsx -r dotenv/config test-webview-crud.ts",
    "test:webview": "tsx -r dotenv/config test-webview-crud.ts",
    "gen:vapid": "tsx src/services/gen-vapid.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.4"
  }
}