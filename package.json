{
  "name": "postre-ordering-system",
  "version": "1.0.0",
  "description": "Postre Food Products - Messenger Ordering & Reservation System",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\" && node dist/server.js",
    "postinstall": "npm run build",
    "seed": "echo Seed disabled on the live system - it would add sample products/packages. See src/db/seed.ts.",
    "db:checkpoint": "node -e \"const{DatabaseSync}=require('node:sqlite');const db=new DatabaseSync('data/postre.db');db.exec('PRAGMA wal_checkpoint(TRUNCATE)');db.close();console.log('WAL checkpointed into data/postre.db')\"",
    "db:seed:supabase": "node dist/db/seed-to-supabase.js",
    "db:seed:supabase:tsx": "tsx src/db/seed-to-supabase.ts",
    "db:seed:sqlite": "node dist/db/seed.js",
    "db:seed:sqlite:tsx": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.4"
  }
}